---
import{getEmDashEntry}from"emdash";import Base from"../layouts/Base.astro";import Home from"../components/Home";import{homepageContent,siteRoutes}from"../data/homepage-content";
const{entry}=await getEmDashEntry("pages","home");const blocks=(entry?.data as any)?.content??[];const byType=Object.fromEntries(blocks.map((b:any)=>[b._type,b]));
const h=byType.ap_hero,a=byType.ap_authority_gap,c=byType.ap_control_loop,d=byType.ap_durable_proof,w=byType.ap_works_with,z=byType.ap_closing;
const content=entry?{seo:{title:(entry.data as any).title??homepageContent.seo.title,description:(entry.data as any).description??homepageContent.seo.description},hero:{eyebrow:h?.eyebrow??homepageContent.hero.eyebrow,title:h?.title??homepageContent.hero.title,titleLines:h?.title_lines?.map((x:any)=>x.text)??homepageContent.hero.titleLines,subtitle:h?.subtitle??homepageContent.hero.subtitle,trustLine:h?.trust_line??homepageContent.hero.trustLine},receipt:{id:h?.receipt_id??homepageContent.receipt.id,objective:h?.receipt_objective??homepageContent.receipt.objective,commit:h?.receipt_commit??homepageContent.receipt.commit,rows:h?.receipt_rows?.map((x:any)=>[x.label,x.value,x.detail])??homepageContent.receipt.rows},authorityGap:{eyebrow:a?.eyebrow??homepageContent.authorityGap.eyebrow,title:a?.title??homepageContent.authorityGap.title,text:a?.text??homepageContent.authorityGap.text},controlLoop:{eyebrow:c?.eyebrow??homepageContent.controlLoop.eyebrow,title:c?.title??homepageContent.controlLoop.title,text:c?.text??homepageContent.controlLoop.text,steps:c?.steps??homepageContent.controlLoop.steps},durableProof:{eyebrow:d?.eyebrow??homepageContent.durableProof.eyebrow,title:d?.title??homepageContent.durableProof.title,text:d?.text??homepageContent.durableProof.text,commit:d?.commit??homepageContent.durableProof.commit,summary:d?.summary??homepageContent.durableProof.summary,files:d?.files?.map((x:any)=>x.path)??homepageContent.durableProof.files,facts:d?.facts?.map((x:any)=>[x.label,x.value])??homepageContent.durableProof.facts,footer:d?.footer??homepageContent.durableProof.footer},worksWith:{title:w?.title??homepageContent.worksWith.title,text:w?.text??homepageContent.worksWith.text,tools:w?.tools?.map((x:any)=>x.name)??homepageContent.worksWith.tools},closing:{title:z?.title??homepageContent.closing.title,text:z?.text??homepageContent.closing.text},links:{quickstart:siteRoutes.quickstart,acr:siteRoutes.acr}}:{...homepageContent,links:{quickstart:siteRoutes.quickstart,acr:siteRoutes.acr}};
---
<Base title={content.seo.title.replace(" | Agentplane","")} description={content.seo.description} canonical="https://v2.agentplane.org/"><Home content={content} client:load/></Base>
